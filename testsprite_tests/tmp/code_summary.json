{
  "tech_stack": [
    "Python",
    "FastAPI",
    "PostgreSQL",
    "SQLAlchemy",
    "Pydantic",
    "JWT",
    "Google OAuth",
    "Uvicorn",
    "Alembic",
    "React",
    "TypeScript",
    "Vite",
    "Radix UI",
    "Tailwind CSS",
    "Machine Learning",
    "scikit-learn",
    "LLM Integration"
  ],
  "features": [
    {
      "name": "Authentication API",
      "description": "Sistema de autenticación con login tradicional y Google OAuth",
      "files": [
        "control/Nutricion-api/nutricion-api/app/api/v1/endpoints/auth.py",
        "control/Nutricion-api/nutricion-api/app/application/services/auth_service.py",
        "control/Nutricion-api/nutricion-api/app/infrastructure/security/jwt_service.py",
        "control/Nutricion-api/nutricion-api/app/infrastructure/security/google_oauth_client.py"
      ],
      "api_doc": {
        "paths": {
          "/api/v1/auth/login": {
            "post": {
              "summary": "Login de usuario",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "usr_usuario": {"type": "string"},
                        "usr_password": {"type": "string"}
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Token de acceso",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "access_token": {"type": "string"},
                          "token_type": {"type": "string"}
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "/api/v1/auth/logout": {
            "post": {
              "summary": "Logout de usuario",
              "security": [{"BearerAuth": []}]
            }
          },
          "/api/v1/auth/google": {
            "post": {
              "summary": "Login con Google",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "id_token": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          },
          "/api/v1/auth/google/start": {
            "get": {
              "summary": "Iniciar login con Google",
              "parameters": [
                {
                  "name": "redirect_to",
                  "in": "query",
                  "schema": {"type": "string"}
                }
              ]
            }
          },
          "/api/v1/auth/google/callback": {
            "get": {
              "summary": "Callback de Google OAuth",
              "parameters": [
                {"name": "code", "in": "query", "schema": {"type": "string"}},
                {"name": "state", "in": "query", "schema": {"type": "string"}},
                {"name": "error", "in": "query", "schema": {"type": "string"}}
              ]
            }
          }
        }
      }
    },
    {
      "name": "User Management API",
      "description": "Gestión de usuarios, perfiles y roles",
      "files": [
        "control/Nutricion-api/nutricion-api/app/api/v1/endpoints/usuarios.py",
        "control/Nutricion-api/nutricion-api/app/application/services/usuarios_service.py",
        "control/Nutricion-api/nutricion-api/app/infrastructure/repositories/usuarios_repo.py"
      ],
      "api_doc": {
        "paths": {
          "/api/v1/usuarios/register": {
            "post": {
              "summary": "Registrar nuevo usuario",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "usr_usuario": {"type": "string"},
                        "usr_email": {"type": "string"},
                        "usr_password": {"type": "string"},
                        "usr_nombre": {"type": "string"},
                        "usr_apellido": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          },
          "/api/v1/usuarios/me": {
            "get": {
              "summary": "Obtener perfil del usuario autenticado",
              "security": [{"BearerAuth": []}]
            }
          },
          "/api/v1/usuarios/profile": {
            "put": {
              "summary": "Actualizar perfil del usuario",
              "security": [{"BearerAuth": []}]
            }
          },
          "/api/v1/usuarios/roles": {
            "post": {
              "summary": "Crear nuevo rol",
              "security": [{"BearerAuth": []}]
            }
          },
          "/api/v1/usuarios/{usr_id}/role": {
            "put": {
              "summary": "Cambiar rol de usuario",
              "security": [{"BearerAuth": []}]
            }
          }
        }
      }
    },
    {
      "name": "Children Management API",
      "description": "Gestión de perfiles de niños, antropometría y evaluación nutricional",
      "files": [
        "control/Nutricion-api/nutricion-api/app/api/v1/endpoints/ninos.py",
        "control/Nutricion-api/nutricion-api/app/application/services/ninos_service.py",
        "control/Nutricion-api/nutricion-api/app/infrastructure/repositories/ninos_repo.py"
      ],
      "api_doc": {
        "paths": {
          "/api/v1/children/self": {
            "get": {
              "summary": "Obtener o crear perfil antropométrico personal",
              "security": [{"BearerAuth": []}]
            }
          },
          "/api/v1/children/profiles": {
            "post": {
              "summary": "Crear perfil completo de niño",
              "security": [{"BearerAuth": []}],
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "nino": {
                          "type": "object",
                          "properties": {
                            "nin_nombres": {"type": "string"},
                            "nin_fecha_nac": {"type": "string", "format": "date"},
                            "nin_sexo": {"type": "string", "enum": ["M", "F"]}
                          }
                        },
                        "antropometria": {
                          "type": "object",
                          "properties": {
                            "ant_peso": {"type": "number"},
                            "ant_talla": {"type": "number"},
                            "ant_fecha": {"type": "string", "format": "date"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "/api/v1/children": {
            "get": {
              "summary": "Listar niños del usuario",
              "security": [{"BearerAuth": []}]
            },
            "post": {
              "summary": "Crear nuevo niño",
              "security": [{"BearerAuth": []}]
            }
          },
          "/api/v1/children/{nin_id}": {
            "get": {
              "summary": "Obtener niño por ID",
              "security": [{"BearerAuth": []}]
            },
            "put": {
              "summary": "Actualizar niño",
              "security": [{"BearerAuth": []}]
            },
            "delete": {
              "summary": "Eliminar niño",
              "security": [{"BearerAuth": []}]
            }
          },
          "/api/v1/children/{nin_id}/anthropometry": {
            "post": {
              "summary": "Agregar medición antropométrica",
              "security": [{"BearerAuth": []}]
            },
            "get": {
              "summary": "Obtener historial antropométrico",
              "security": [{"BearerAuth": []}]
            }
          },
          "/api/v1/children/{nin_id}/nutritional-status": {
            "get": {
              "summary": "Obtener estado nutricional",
              "security": [{"BearerAuth": []}]
            }
          },
          "/api/v1/children/{nin_id}/allergies": {
            "get": {
              "summary": "Obtener alergias del niño",
              "security": [{"BearerAuth": []}]
            },
            "post": {
              "summary": "Agregar alergia",
              "security": [{"BearerAuth": []}]
            }
          }
        }
      }
    },
    {
      "name": "Allergies Management API",
      "description": "Gestión de tipos de alergias",
      "files": [
        "control/Nutricion-api/nutricion-api/app/api/v1/api.py"
      ],
      "api_doc": {
        "paths": {
          "/api/v1/alergias/tipos": {
            "get": {
              "summary": "Obtener tipos de alergias",
              "parameters": [
                {"name": "q", "in": "query", "schema": {"type": "string"}},
                {"name": "limit", "in": "query", "schema": {"type": "integer", "default": 50}}
              ]
            },
            "post": {
              "summary": "Crear tipo de alergia",
              "security": [{"BearerAuth": []}]
            }
          }
        }
      }
    },
    {
      "name": "Entities Management API",
      "description": "Gestión de entidades del sistema",
      "files": [
        "control/Nutricion-api/nutricion-api/app/api/v1/endpoints/entidades.py",
        "control/Nutricion-api/nutricion-api/app/infrastructure/repositories/entidades_repo.py"
      ],
      "api_doc": {
        "paths": {
          "/api/v1/entidades": {
            "get": {
              "summary": "Listar entidades",
              "parameters": [
                {"name": "q", "in": "query", "schema": {"type": "string"}},
                {"name": "limit", "in": "query", "schema": {"type": "integer", "default": 20}}
              ]
            }
          },
          "/api/v1/entidades/tipos": {
            "get": {
              "summary": "Obtener tipos de entidades"
            }
          }
        }
      }
    },
    {
      "name": "Machine Learning API",
      "description": "API para resúmenes nutricionales usando ML y LLM",
      "files": [
        "control/Nutricion-api/nutricion-api/app/api/v1/endpoints/ml.py",
        "modelo/ml-recomendator/src/llm/assist.py"
      ],
      "api_doc": {
        "paths": {
          "/api/v1/ml/summary": {
            "post": {
              "summary": "Generar resumen nutricional usando ML/LLM",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "features": {"type": "object"},
                        "scores": {"type": "object"},
                        "prefer_llm": {"type": "boolean", "default": true}
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Resumen generado",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "text": {"type": "string"},
                          "used_llm": {"type": "boolean"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Health Check API",
      "description": "Endpoint de verificación de salud del sistema",
      "files": [
        "control/Nutricion-api/nutricion-api/app/main.py"
      ],
      "api_doc": {
        "paths": {
          "/health": {
            "get": {
              "summary": "Verificar estado del sistema",
              "responses": {
                "200": {
                  "description": "Sistema funcionando",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "status": {"type": "string", "example": "ok"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

