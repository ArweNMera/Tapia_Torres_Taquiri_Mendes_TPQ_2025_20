# Configuración de PRODUCCIÓN
# Copiar este archivo como .env.production y completar con tus credenciales reales

# Base de Datos MySQL (Producción)
DB_HOST=tu_host_produccion
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_produccion
DB_NAME=nutricion

# Secret Key (Producción) - Generar con: openssl rand -hex 32
SECRET_KEY=tu_secret_key_aqui

# Google OAuth (Producción)
# Obtener de: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/v1/auth/google/callback
GOOGLE_POST_LOGIN_REDIRECT=https://tu-frontend.com
GOOGLE_ALLOWED_REDIRECTS=https://tu-frontend.com

# API ML (Producción)
ML_API_URL=https://tu-api-ml-produccion.com
